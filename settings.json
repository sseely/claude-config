{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(openssl:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(pip3 install:*)",
      "Bash(shellcheck:*)",
      "Bash(ast-grep:*)",
      "Bash(lizard:*)",
      "Bash(gzip:*)",
      "Bash(forge lint *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git check-ignore:*)",
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git -C:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git pull:*)",
      "Bash(git config:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh auth:*)",
      "Bash(gh run:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm test:*)",
      "Bash(npm --version)",
      "Bash(npm info:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm --version)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(volta install:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(dotnet:*)",
      "Bash(git tag:*)",
      "Bash(npm ci:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(uv:*)",
      "Bash(mkdocs build:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker info:*)",
      "Bash(docker model:*)",
      "Bash(docker pull:*)",
      "Bash(docker run:*)",
      "Bash(docker search:*)",
      "Bash(ollama list:*)",
      "Bash(ollama show:*)",
      "Bash(command -v:*)",
      "Bash(claude mcp:*)",
      "Bash(~/.claude/hooks/quality-gate.sh:*)",
      "Bash(~/.claude/hooks/setup-complexity.sh)",
      "Bash(~/.claude/hooks/autonomous-toggle.sh on:*)",
      "Bash(~/.claude/hooks/autonomous-toggle.sh off:*)",
      "Bash(~/.claude/hooks/project-init.sh:*)",
      "Edit(~/git/**)",
      "Read(~/git/**)",
      "Grep(~/git/**)",
      "Edit(~/.claude/**)",
      "Read(~/.claude/**)",
      "Grep(~/.claude/**)",
      "Edit(~/church/**)",
      "Read(~/church/**)",
      "Grep(~/church/**)",
      "WebFetch",
      "WebSearch",
      "Skill(update-config:*)",
      "Skill(plan-mission:*)",
      "mcp__serena__*"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "model": "opus",
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/record-turn-start.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-init.sh",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/post-compact-context.md"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '-- COMPACTING: verify open TODOs are committed --'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-bash.py"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/nudge-search-tool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-complexity.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-frontmatter.py"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-instructions-loaded.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PermissionDenied",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PostToolUseFailure",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh SubagentStop",
            "async": true
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PostModelSwitch",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(npm run visual:upload:*) in /Users/scottseely/git/knowvah/plantuml-ts — publishes visual assets to a remote target; treat as Public Data-Sharing Upload pending confirmation",
      "Bash(git push --force*) on knowvah/plantuml-ts main — no branch protection or ruleset is configured server-side, so a force-push is not blocked upstream"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — knowvah/plantuml-ts (github.com/knowvah/plantuml-ts). Any push here publishes.",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch `main`; no rulesets or classic protected branches listed on knowvah/plantuml-ts (gh reports none — this repo appears unprotected server-side, not merely ruleset-protected)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (github.com/knowvah/plantuml-ts) and its origin remote only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: npm.pkg.github.com (GitHub Packages registry, scoped to this repo's package.json)",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. Note: assets/manifests/k8s.json, assets/manifests/kubernetes.json, scripts/split-sprite-bundle/allowlist.ts flagged by filename scan as worth checking before wide sharing.",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (porting PlantUML Java to TypeScript in this repo)",
      "**Trusted repo**: /Users/scottseely/git/knowvah/plantuml-ts and its origin remote (github.com/knowvah/plantuml-ts, PUBLIC) — only this repo's own work belongs here; ported/repointed content from outside this session's repo is not its own work",
      "**Org-specific CLIs**: None configured",
      "routine under scottseely/ prefix: none identified from evidence"
    ]
  }
}
