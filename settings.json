{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(chmod:*)",
      "Bash(mkdir *:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(openssl *:*)",
      "Bash(node *:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(python3:*)",
      "Bash(pip3 install:*)",
      "Bash(shellcheck:*)",
      "Bash(ast-grep:*)",
      "Bash(lizard:*)",
      "Bash(gzip:*)",
      "Bash(forge lint *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git check-ignore:*)",
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git -C:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git pull:*)",
      "Bash(git config:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh auth:*)",
      "Bash(gh run:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm --version)",
      "Bash(npm info:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm --version)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run:*)",
      "Bash(volta install:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(dotnet:*)",
      "Bash(git tag:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(uv:*)",
      "Bash(mkdocs build:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker info:*)",
      "Bash(docker model:*)",
      "Bash(docker pull:*)",
      "Bash(docker run:*)",
      "Bash(docker search:*)",
      "Bash(ollama list:*)",
      "Bash(ollama show:*)",
      "Bash(command -v:*)",
      "Bash(claude mcp:*)",
      "Bash(~/.claude/hooks/quality-gate.sh:*)",
      "Bash(~/.claude/hooks/setup-complexity.sh)",
      "Bash(~/.claude/hooks/autonomous-toggle.sh on:*)",
      "Bash(~/.claude/hooks/autonomous-toggle.sh off:*)",
      "Bash(~/.claude/hooks/project-init.sh:*)",
      "Edit(~/git/**)",
      "Read(~/git/**)",
      "Grep(~/git/**)",
      "Edit(~/.claude/**)",
      "Read(~/.claude/**)",
      "Grep(~/.claude/**)",
      "Edit(~/church/**)",
      "Read(~/church/**)",
      "Grep(~/church/**)",
      "WebFetch",
      "WebSearch",
      "Agent(*)",
      "Skill(update-config:*)",
      "Skill(plan-mission:*)",
      "mcp__serena__*",
      "Bash(awk -F: 'length\\($0\\)-length\\($1\\)-1 > 80 {print length\\($0\\)\": \"$0}')"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp",
      "/Users/scottseely"
    ]
  },
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/record-turn-start.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-init.sh",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/post-compact-context.md"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '-- COMPACTING: verify open TODOs are committed --'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-bash.py"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/nudge-search-tool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-complexity.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-frontmatter.py"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -u +%Y-%m-%dT%H:%M:%SZ)] InstructionsLoaded\" >> ~/.claude/logs/instructions-loaded.log 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "agentPushNotifEnabled": true
}
