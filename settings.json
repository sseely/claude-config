{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(openssl:*)",
      "Bash(pip3 install:*)",
      "Bash(shellcheck:*)",
      "Bash(ast-grep:*)",
      "Bash(lizard:*)",
      "Bash(gzip:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git check-ignore:*)",
      "Bash(git remote:*)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git -C:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git pull:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh auth:*)",
      "Bash(gh run:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm test:*)",
      "Bash(npm --version)",
      "Bash(npm info:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm --version)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(dotnet:*)",
      "Bash(git tag:*)",
      "Bash(npm ci:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker info:*)",
      "Bash(command -v:*)",
      "Bash(claude mcp:*)",
      "Bash(~/.claude/hooks/setup-complexity.sh)",
      "Bash(~/.claude/hooks/autonomous-toggle.sh off:*)",
      "Bash(~/.claude/hooks/project-init.sh:*)",
      "Edit(~/git/**)",
      "Read(~/git/**)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/docs/**)",
      "Read(~/.claude/**)",
      "Edit(~/church/**)",
      "Read(~/church/**)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:airc.nist.gov)",
      "WebFetch(domain:www.nist.gov)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:developer.atlassian.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:ast-grep.github.io)",
      "WebSearch",
      "Skill(update-config:*)",
      "Skill(plan-mission:*)",
      "mcp__serena__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(gh repo delete*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "model": "opus",
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/post-compact-context.md"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/record-turn-start.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-init.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-bash.py",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/nudge-search-tool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-complexity.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-frontmatter.py"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-instructions-loaded.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh StopFailure",
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PermissionDenied",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PostToolUseFailure",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh SubagentStop",
            "async": true
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PostModelSwitch",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(npm run visual:upload:*) in /Users/scottseely/git/knowvah/plantuml-ts — publishes visual assets to a remote target; treat as Public Data-Sharing Upload pending confirmation",
      "Bash(git push --force*) to the default branch of any repository — assume no server-side branch protection unless verified"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Varies per repository — check the remote's visibility (`gh repo view --json visibility`) before treating a push as private. github.com/knowvah/plantuml-ts is PUBLIC.",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch is usually `main`; assume no server-side branch protection unless verified, so a force-push is not blocked upstream.",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The working repository and its origin remote, plus repositories under `~/git/**` and the `~/.claude` configuration repo. No additional orgs configured.",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: npm.pkg.github.com (GitHub Packages registry, scoped to this repo's package.json)",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar.",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development, including maintaining the `~/.claude` Claude Code configuration repo.",
      "**Trusted repo**: The repository Claude Code was started in and its origin remote, plus `~/.claude` (the user's Claude Code configuration repo) and repositories under `~/git/**`. Content ported or repointed from outside the session's repository is not that repository's own work.",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
