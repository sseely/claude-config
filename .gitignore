# Per-agent memory (machine-local, not synced)
agent-memory/

# Hook runtime state (turn timestamps, etc.)
.runtime/

# Bytecode from exercising the python quality gate (hooks/check-complexity.py)
__pycache__/

# Daemon / background-agent runtime state (contains secrets — control.key,
# auth/ — and PII in telemetry; must never be committed)
daemon/
daemon.lock
daemon.log
daemon.status.json
daemon-auth-*
jobs/
logs/
telemetry/
chrome/
.last-update-result.json

# Auto-mutated by Claude Code's own runtime cleanup; produces a content-free diff
.last-cleanup

# MCP config has machine-specific paths
.mcp.json

